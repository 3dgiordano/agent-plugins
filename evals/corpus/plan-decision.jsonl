// Corpus for executive-self-monitoring/lib/writeback.js - isDecision().
// The OWNER's prompt decides something: it opens on a pick or an approval.
// Counted towards "decisions since the plan last changed"; a miss costs one
// count, a false hit brings the plan reminder a decision early.
// Misses: a question about an option, a letter inside a sentence, "a" as a word.
{"text": "A", "expect": "hit", "why": "a bare option letter"}
{"text": "B: keep the old endpoint and add the new one beside it.", "expect": "hit", "why": "letter and colon"}
{"text": "A, adelante", "expect": "hit", "why": "letter and the go-ahead"}
{"text": "C, dale", "expect": "hit", "why": "letter and dale"}
{"text": "B, but keep the flag off by default.", "expect": "hit", "why": "letter, comma and a condition"}
{"text": "Option A.", "expect": "hit", "why": "option A"}
{"text": "opción B: migrar primero la tabla de usuarios", "expect": "hit", "why": "opción B"}
{"text": "adelante con A", "expect": "hit", "why": "adelante con A"}
{"text": "go with B", "expect": "hit", "why": "go with B"}
{"text": "Go ahead with option C, and write the migration first.", "expect": "hit", "why": "go ahead with option C"}
{"text": "sí, adelante", "expect": "hit", "why": "sí, adelante"}
{"text": "Sí: implementa el cambio tal como está propuesto.", "expect": "hit", "why": "sí: implementa"}
