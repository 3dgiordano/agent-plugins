// Corpus for handoff-self-monitoring/lib/handoff.js - scan().
// A decision named but not handed off: an offer ("let me know", "should I"),
// or a fork stated without a default, in a closing message with no [HANDOFF]
// block. A close that already carries a well-formed block must not fire.

{"text": "The parser is done. Let me know if you want the streaming path too.", "expect": "hit", "why": "offer: let me know"}
{"text": "Tests pass. If you'd like, I can also wire the retries.", "expect": "hit", "why": "offer: if you would like"}
{"text": "Migration written. Would you like me to run it against staging?", "expect": "hit", "why": "offer: would you like me to"}
{"text": "I fixed the leak. Should I also bump the dependency?", "expect": "hit", "why": "offer: should I"}
{"text": "Refactor complete. Want me to split it into two commits?", "expect": "hit", "why": "offer: want me to"}
{"text": "Both approaches work - up to you.", "expect": "hit", "why": "offer: up to you"}
{"text": "I can use a queue or a cron. Your call.", "expect": "hit", "why": "offer: your call"}
{"text": "Done. Happy to switch it to a worker pool instead.", "expect": "hit", "why": "offer: happy to switch"}
{"text": "Which one to pick depends on whether you need ordering guarantees.", "expect": "hit", "why": "fork: depends on"}
{"text": "I used a mutex. Alternatively, a channel would work.", "expect": "hit", "why": "fork: alternatively"}
{"text": "The other option is to denormalize the table.", "expect": "hit", "why": "fork: the other option"}
{"text": "There are three approaches to this caching problem.", "expect": "hit", "why": "fork: three approaches"}
{"text": "Option A is faster; option B is simpler to review.", "expect": "hit", "why": "fork: option A / B"}
{"text": "There are real trade-offs between the two designs.", "expect": "hit", "why": "fork: trade-offs"}
{"text": "We could either batch the writes or widen the lock.", "expect": "hit", "why": "fork: could either"}
{"text": "Which would you prefer for the retry backoff?", "expect": "hit", "why": "fork: which would you prefer"}

