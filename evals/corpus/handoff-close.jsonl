// --- probes for the object-anchored "depends on" pattern ---

{"text": "The scheduler depends on lodash and date-fns.", "expect": "miss", "why": "a package dependency, not a fork"}
{"text": "This module depends on node 22.", "expect": "miss", "why": "a runtime dependency - note 'This depends on' would have fired on the adjacent-pronoun pattern, the object is what saves it"}
